# =============================================================================
# ZAARA TRAVELS ENVIRONMENT CONFIGURATION (.env.example)
# Hostinger & Production Node.js Environment Setup
# =============================================================================

# Server Port & Mode
PORT=3000
NODE_ENV=development
APP_URL=https://www.zaaratravel.com

# Gemini AI Key (Automatically injected in AI Studio)
GEMINI_API_KEY=

# Google Maps Platform Key (Places & Routes API)
GOOGLE_MAPS_PLATFORM_KEY=

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL / PostgreSQL / Supabase)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=u123456789_zaaratravel
DB_PASSWORD=YourStrongDatabasePassword123!
DB_NAME=u123456789_zaara_db
DB_PORT=3306

# Supabase / PostgreSQL Credentials
POSTGRES_HOST=db.lhzhqetfjglpsxsvlrem.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# 2. PAYU PAYMENT GATEWAY CONFIGURATION
# -----------------------------------------------------------------------------
# Test Credentials / Production Credentials from PayU Merchant Dashboard
PAYU_MERCHANT_KEY=JP2V9q
PAYU_MERCHANT_SALT=qwerty12345
PAYU_ENV=TEST  # Change to 'LIVE' for production (https://secure.payu.in/_payment)
PAYU_PAYMENT_URL=https://test.payu.in/_payment

# -----------------------------------------------------------------------------
# 3. PAYPAL INTERNATIONAL GATEWAY CONFIGURATION
# -----------------------------------------------------------------------------
PAYPAL_CLIENT_ID=AXXXXXXXXXXXXXX_YourPayPalClientId
PAYPAL_CLIENT_SECRET=EXXXXXXXXXXXXX_YourPayPalSecretKey
PAYPAL_MODE=sandbox  # Change to 'live' for production (https://api-m.paypal.com)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# -----------------------------------------------------------------------------
# 4. UPI (GOOGLE PAY / PHONEPE / BHIM / PATYM) CONFIGURATION
# -----------------------------------------------------------------------------
UPI_VPA=zaaratravels@icici
UPI_PAYEE_NAME=Zaara Travels Private Limited
UPI_MERCHANT_CODE=4722

# -----------------------------------------------------------------------------
# 5. SMTP EMAIL CONFIGURATION (Nodemailer / Hostinger Webmail)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@zaaratravel.com
SMTP_PASS=YourEmailPassword123!
SMTP_FROM="Zaara Travels" <info@zaaratravel.com>
ADMIN_EMAIL=info@zaaratravel.com

# -----------------------------------------------------------------------------
# 6. TWILIO WHATSAPP & SMS CONFIGURATION
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
ADMIN_WHATSAPP_NUMBER=+919933992786
